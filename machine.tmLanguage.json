{
    "name": "Machine Notation",
    "scopeName": "source.machine",
    "patterns": [
        {
            "include": "#statement"
        }
    ],
    "repository": {
        "statement": {
            "patterns": [
                {
                    "comment": "A bracketed statement",
                    "begin": "\\[",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.section.bracket.begin.machine"
                        }
                    },
                    "end": "\\]",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.bracket.end.machine"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#machine_header"
                        },
                        {
                            "include": "#header"
                        },
                        {
                            "include": "#wiring"
                        }
                    ]
                },
                {
                    "comment": "A line-based statement: a machine header",
                    "include": "#machine_header"
                },
                {
                    "comment": "A line-based statement: a cap header",
                    "include": "#header_line"
                },
                {
                    "comment": "A line-based statement: a wiring",
                    "include": "#wiring"
                }
            ]
        },
        "header": {
            "comment": "Header: alias followed by cap URN",
            "begin": "([a-zA-Z_][a-zA-Z0-9_-]*)\\s+(cap:)",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.function.alias.machine"
                },
                "2": {
                    "name": "keyword.other.cap-prefix.machine"
                }
            },
            "end": "(?=\\])",
            "patterns": [
                {
                    "include": "#cap_urn_body"
                }
            ]
        },
        "cap_urn_body": {
            "patterns": [
                {
                    "comment": "Direction spec keys: in= and out=",
                    "match": "\\b(in|out)(?==)",
                    "name": "keyword.other.direction-spec.machine"
                },
                {
                    "comment": "op= key",
                    "match": "\\b(op)(?==)",
                    "name": "keyword.other.op.machine"
                },
                {
                    "comment": "Quoted media URN value",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.machine"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.machine"
                        }
                    },
                    "name": "string.quoted.double.machine",
                    "patterns": [
                        {
                            "comment": "media: prefix inside quoted value",
                            "match": "media:",
                            "name": "support.type.media-prefix.machine"
                        },
                        {
                            "comment": "Escape sequences",
                            "match": "\\\\.",
                            "name": "constant.character.escape.machine"
                        }
                    ]
                },
                {
                    "comment": "Unquoted media URN after = (e.g., in=media:image)",
                    "match": "(?<==)(media:[a-zA-Z0-9_-]*)",
                    "captures": {
                        "1": {
                            "name": "string.unquoted.media-urn.machine"
                        }
                    }
                },
                {
                    "comment": "Semicolon separator",
                    "match": ";",
                    "name": "punctuation.separator.semicolon.machine"
                },
                {
                    "comment": "Equals sign",
                    "match": "=",
                    "name": "keyword.operator.assignment.machine"
                },
                {
                    "comment": "Tag key (other than in/out/op)",
                    "match": "\\b([a-zA-Z][a-zA-Z0-9_-]*)(?=[;\\]]|$)",
                    "captures": {
                        "1": {
                            "name": "variable.other.tag.machine"
                        }
                    }
                }
            ]
        },
        "wiring": {
            "patterns": [
                {
                    "comment": "Arrow operator",
                    "match": "-+>",
                    "name": "keyword.operator.arrow.machine"
                },
                {
                    "comment": "A step's policy, in braces after the step",
                    "begin": "(?<=[a-zA-Z0-9_-])\\s*(\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.section.policy.begin.machine"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.policy.end.machine"
                        }
                    },
                    "patterns": [
                        {
                            "match": "\\b(retry|on_error)\\b",
                            "name": "keyword.other.policy.machine"
                        },
                        {
                            "match": "\\babsent\\b",
                            "name": "constant.language.policy.machine"
                        },
                        {
                            "match": "=",
                            "name": "keyword.operator.assignment.machine"
                        },
                        {
                            "match": "\\d+",
                            "name": "constant.numeric.machine"
                        },
                        {
                            "match": ",",
                            "name": "punctuation.separator.comma.machine"
                        }
                    ]
                },
                {
                    "comment": "A member or target that names its arg or output",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(=)(?!>)",
                    "captures": {
                        "1": {
                            "name": "variable.parameter.name.machine"
                        },
                        "2": {
                            "name": "keyword.operator.assignment.machine"
                        }
                    }
                },
                {
                    "include": "#json_string"
                },
                {
                    "include": "#json_number"
                },
                {
                    "include": "#json_literal"
                },
                {
                    "include": "#json_array"
                },
                {
                    "comment": "A constant object",
                    "begin": "(?<==)\\s*(\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.section.object.begin.machine"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.object.end.machine"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#json_string"
                        },
                        {
                            "include": "#json_number"
                        },
                        {
                            "include": "#json_literal"
                        },
                        {
                            "include": "#json_array"
                        },
                        {
                            "include": "#json_object"
                        },
                        {
                            "match": ",",
                            "name": "punctuation.separator.comma.machine"
                        },
                        {
                            "match": ":",
                            "name": "punctuation.separator.key-value.machine"
                        }
                    ]
                },
                {
                    "comment": "Group opening paren",
                    "match": "\\(",
                    "name": "punctuation.section.group.begin.machine"
                },
                {
                    "comment": "Group closing paren",
                    "match": "\\)",
                    "name": "punctuation.section.group.end.machine"
                },
                {
                    "comment": "Comma separator in a group",
                    "match": ",",
                    "name": "punctuation.separator.comma.machine"
                },
                {
                    "comment": "Node or step",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*\\b",
                    "name": "variable.other.alias.machine"
                }
            ]
        },
        "header_line": {
            "comment": "Line-based header: alias followed by cap URN, to the end of the line",
            "begin": "([a-zA-Z_][a-zA-Z0-9_-]*)\\s+(cap:)",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.function.alias.machine"
                },
                "2": {
                    "name": "keyword.other.cap-prefix.machine"
                }
            },
            "end": "$",
            "patterns": [
                {
                    "include": "#cap_urn_body"
                }
            ]
        },
        "machine_header": {
            "comment": "Machine header: an alias for another machine, by an opaque reference",
            "match": "([a-zA-Z_][a-zA-Z0-9_-]*)\\s+(machine)\\s+(\"(?:[^\"\\\\]|\\\\.)*\")",
            "captures": {
                "1": {
                    "name": "entity.name.function.alias.machine"
                },
                "2": {
                    "name": "keyword.other.machine.machine"
                },
                "3": {
                    "name": "string.quoted.double.reference.machine"
                }
            }
        },
        "json_string": {
            "begin": "\"",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.string.begin.machine"
                }
            },
            "end": "\"",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.machine"
                }
            },
            "name": "string.quoted.double.constant.machine",
            "patterns": [
                {
                    "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})",
                    "name": "constant.character.escape.machine"
                }
            ]
        },
        "json_number": {
            "match": "-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?(?![a-zA-Z0-9_-])",
            "name": "constant.numeric.machine"
        },
        "json_literal": {
            "match": "\\b(?:true|false|null)\\b(?![a-zA-Z0-9_-])",
            "name": "constant.language.machine"
        },
        "json_array": {
            "begin": "\\[",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.array.begin.machine"
                }
            },
            "end": "\\]",
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.array.end.machine"
                }
            },
            "patterns": [
                {
                    "include": "#json_string"
                },
                {
                    "include": "#json_number"
                },
                {
                    "include": "#json_literal"
                },
                {
                    "include": "#json_array"
                },
                {
                    "include": "#json_object"
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.comma.machine"
                },
                {
                    "match": ":",
                    "name": "punctuation.separator.key-value.machine"
                }
            ]
        },
        "json_object": {
            "begin": "\\{",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.object.begin.machine"
                }
            },
            "end": "\\}",
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.object.end.machine"
                }
            },
            "patterns": [
                {
                    "include": "#json_string"
                },
                {
                    "include": "#json_number"
                },
                {
                    "include": "#json_literal"
                },
                {
                    "include": "#json_array"
                },
                {
                    "include": "#json_object"
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.comma.machine"
                },
                {
                    "match": ":",
                    "name": "punctuation.separator.key-value.machine"
                }
            ]
        }
    }
}
